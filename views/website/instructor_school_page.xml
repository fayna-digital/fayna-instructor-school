<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!--  Public listing page — /instructor-school                    -->
    <!-- ============================================================ -->
    <template id="page_instructor_school" name="Школа вожатих — список курсів">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <!-- Hero -->
                <section class="o_colored_level o_cc o_cc1 pt-5 pb-5 text-center">
                    <div class="container">
                        <h1 class="display-4 fw-bold">Школа вожатих</h1>
                        <p class="lead">
                            Навчання вожатих та керівників таборів за програмою MEN (36h/10h)
                        </p>
                    </div>
                </section>

                <!-- Course listing -->
                <section class="pt-5 pb-5">
                    <div class="container">
                        <t t-if="not courses">
                            <div class="alert alert-info text-center">
                                Наразі немає відкритих курсів. Слідкуйте за оновленнями.
                            </div>
                        </t>
                        <div class="row g-4">
                            <t t-foreach="courses" t-as="course">
                                <div class="col-md-6 col-lg-4">
                                    <div class="card h-100 shadow-sm">
                                        <div class="card-body d-flex flex-column">
                                            <h5 class="card-title">
                                                <t t-esc="course.name"/>
                                            </h5>
                                            <ul class="list-unstyled text-muted small mb-3">
                                                <li t-if="course.start_date">
                                                    <i class="fa fa-calendar me-1"/>
                                                    <t t-esc="course.start_date"/>
                                                    <t t-if="course.end_date">
                                                        — <t t-esc="course.end_date"/>
                                                    </t>
                                                </li>
                                                <li t-if="course.location">
                                                    <i class="fa fa-map-marker me-1"/>
                                                    <t t-esc="course.location"/>
                                                </li>
                                                <li>
                                                    <i class="fa fa-users me-1"/>
                                                    <t t-esc="course.available_spots"/> місць залишилось
                                                </li>
                                                <li t-if="course.price">
                                                    <i class="fa fa-tag me-1"/>
                                                    <t t-esc="course.price"/>
                                                    <t t-esc="course.currency_id.symbol"/>
                                                </li>
                                            </ul>
                                            <div t-if="course.description"
                                                 class="mb-3 text-muted small"
                                                 t-out="course.description[:300]"/>
                                            <div class="mt-auto">
                                                <t t-if="course.available_spots &gt; 0">
                                                    <a t-attf-href="/instructor-school/apply/#{course.id}"
                                                       class="btn btn-primary w-100">
                                                        Записатись
                                                    </a>
                                                </t>
                                                <t t-else="">
                                                    <button class="btn btn-secondary w-100" disabled="1">
                                                        Місця закінчились
                                                    </button>
                                                </t>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <!-- ============================================================ -->
    <!--  Application form — /instructor-school/apply/<id>            -->
    <!-- ============================================================ -->
    <template id="page_instructor_apply" name="Школа вожатих — форма заявки">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <section class="pt-5 pb-5">
                    <div class="container">
                        <div class="row justify-content-center">
                            <div class="col-md-7 col-lg-6">

                                <!-- Success state -->
                                <t t-if="success">
                                    <div class="text-center py-5">
                                        <i class="fa fa-check-circle fa-4x text-success mb-3"/>
                                        <h2>Заявку прийнято!</h2>
                                        <p class="lead">
                                            Ваша заявка на курс
                                            <strong><t t-esc="course.name"/></strong>
                                            успішно надіслана.
                                        </p>
                                        <p class="text-muted">
                                            Наша команда підтвердить запис найближчим часом.
                                        </p>
                                        <a href="/instructor-school" class="btn btn-outline-primary mt-3">
                                            Назад до курсів
                                        </a>
                                    </div>
                                </t>

                                <!-- Form state -->
                                <t t-if="not success">
                                    <h2 class="mb-1">Записатись на курс</h2>
                                    <p class="text-muted mb-4">
                                        <strong><t t-esc="course.name"/></strong>
                                        <t t-if="course.start_date">
                                            — початок <t t-esc="course.start_date"/>
                                        </t>
                                    </p>

                                    <!-- Error banner -->
                                    <t t-if="error">
                                        <div class="alert alert-danger" role="alert">
                                            <i class="fa fa-exclamation-triangle me-1"/>
                                            <t t-esc="error"/>
                                        </div>
                                    </t>

                                    <!-- Fully booked banner -->
                                    <t t-if="course.available_spots &lt;= 0 and not error">
                                        <div class="alert alert-warning text-center">
                                            <i class="fa fa-ban me-1"/>
                                            На жаль, всі місця на цей курс зайняті.
                                        </div>
                                    </t>

                                    <form t-attf-action="/instructor-school/apply/#{course.id}"
                                          method="post"
                                          t-if="course.available_spots &gt; 0">
                                        <input type="hidden" name="csrf_token"
                                               t-att-value="request.csrf_token()"/>

                                        <div class="mb-3">
                                            <label for="applicant_name" class="form-label fw-semibold">
                                                Ім'я та прізвище <span class="text-danger">*</span>
                                            </label>
                                            <input type="text"
                                                   class="form-control"
                                                   id="applicant_name"
                                                   name="applicant_name"
                                                   required="required"
                                                   placeholder="Іваненко Іван Іванович"/>
                                        </div>

                                        <div class="mb-3">
                                            <label for="applicant_email" class="form-label fw-semibold">
                                                Email <span class="text-danger">*</span>
                                            </label>
                                            <input type="email"
                                                   class="form-control"
                                                   id="applicant_email"
                                                   name="applicant_email"
                                                   required="required"
                                                   placeholder="ivan@example.com"/>
                                        </div>

                                        <div class="mb-4">
                                            <label for="applicant_phone" class="form-label fw-semibold">
                                                Телефон
                                            </label>
                                            <input type="tel"
                                                   class="form-control"
                                                   id="applicant_phone"
                                                   name="applicant_phone"
                                                   placeholder="+48 500 000 000"/>
                                        </div>

                                        <div class="d-grid gap-2">
                                            <button type="submit" class="btn btn-primary btn-lg">
                                                Надіслати заявку
                                            </button>
                                            <a href="/instructor-school" class="btn btn-outline-secondary">
                                                Скасувати
                                            </a>
                                        </div>
                                    </form>

                                    <t t-if="course.available_spots &lt;= 0">
                                        <div class="text-center mt-3">
                                            <a href="/instructor-school" class="btn btn-outline-primary">
                                                Назад до курсів
                                            </a>
                                        </div>
                                    </t>
                                </t>

                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <!-- ============================================================ -->
    <!--  Enrollment confirmation page (auth=user flow)               -->
    <!-- ============================================================ -->
    <template id="instructor_school_enroll_confirm" name="Instructor School — Enrollment Confirmed">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <section class="pt-5 pb-5">
                    <div class="container text-center">
                        <div class="py-5">
                            <i class="fa fa-check-circle fa-4x text-success mb-3"/>
                            <h2>Запис підтверджено!</h2>
                            <p class="lead">
                                Вас записано на курс
                                <strong><t t-esc="course.name"/></strong>.
                            </p>
                            <p class="text-muted">
                                Наша команда підтвердить ваш запис найближчим часом.
                            </p>
                            <a href="/instructor-school" class="btn btn-outline-primary mt-3">
                                Назад до курсів
                            </a>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <!-- ============================================================ -->
    <!--  Already enrolled page (auth=user flow)                      -->
    <!-- ============================================================ -->
    <template id="instructor_school_already_enrolled" name="Instructor School — Already Enrolled">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <section class="pt-5 pb-5">
                    <div class="container text-center">
                        <div class="py-5">
                            <i class="fa fa-info-circle fa-4x text-info mb-3"/>
                            <h2>Ви вже записані</h2>
                            <p class="lead">
                                Ви вже записані на курс
                                <strong><t t-esc="course.name"/></strong>.
                            </p>
                            <a href="/instructor-school" class="btn btn-outline-primary mt-3">
                                Назад до курсів
                            </a>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>
</odoo>
