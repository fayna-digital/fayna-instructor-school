<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!--  List (tree) view — richer state + payment_status            -->
    <!-- ============================================================ -->
    <record id="fayna_instructor_enrollment_tree" model="ir.ui.view">
        <field name="name">instructor.enrollment.tree.extended</field>
        <field name="model">instructor.enrollment</field>
        <field name="priority">8</field>
        <field name="arch" type="xml">
            <tree decoration-muted="state == 'cancelled'"
                  decoration-success="state == 'confirmed'"
                  decoration-primary="state == 'completed'">
                <field name="course_id"/>
                <field name="partner_id"/>
                <field name="enrollment_date"/>
                <field name="payment_status" widget="badge"
                       decoration-success="payment_status == 'paid'"
                       decoration-warning="payment_status == 'unpaid'"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'confirmed'"
                       decoration-info="state == 'pending'"
                       decoration-muted="state == 'cancelled'"
                       decoration-primary="state == 'completed'"/>
            </tree>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--  Action (enrollment list entry point)                         -->
    <!-- ============================================================ -->
    <record id="action_fayna_instructor_enrollment" model="ir.actions.act_window">
        <field name="name">Enrollments</field>
        <field name="res_model">instructor.enrollment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="instructor_enrollment_search_view"/>
    </record>
</odoo>
