<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!--  Kanban view                                                  -->
    <!-- ============================================================ -->
    <record id="fayna_instructor_course_kanban" model="ir.ui.view">
        <field name="name">fayna.instructor.course.kanban</field>
        <field name="model">fayna.instructor.course</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="state"/>
                <field name="start_date"/>
                <field name="enrolled_count"/>
                <field name="available_spots"/>
                <field name="price"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <strong><field name="name"/></strong>
                                <div class="text-muted">
                                    <field name="start_date"/>
                                    <t t-if="record.location.raw_value">
                                        — <field name="location"/>
                                    </t>
                                </div>
                                <div>
                                    <field name="price" widget="monetary"/>
                                </div>
                                <div class="mt-1">
                                    <span class="badge bg-info">
                                        <field name="enrolled_count"/> enrolled
                                    </span>
                                    <span class="badge bg-success ms-1">
                                        <field name="available_spots"/> spots left
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--  List (tree) view                                             -->
    <!-- ============================================================ -->
    <record id="fayna_instructor_course_tree" model="ir.ui.view">
        <field name="name">fayna.instructor.course.tree</field>
        <field name="model">fayna.instructor.course</field>
        <field name="arch" type="xml">
            <tree decoration-muted="state == 'cancelled'"
                  decoration-success="state == 'open'"
                  decoration-info="state == 'in_progress'">
                <field name="name"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="location"/>
                <field name="price" widget="monetary"/>
                <field name="currency_id" optional="hide"/>
                <field name="max_participants"/>
                <field name="enrolled_count"/>
                <field name="available_spots"/>
                <field name="state"
                       widget="badge"
                       decoration-success="state == 'open'"
                       decoration-info="state == 'in_progress'"
                       decoration-muted="state in ('draft', 'cancelled')"
                       decoration-primary="state == 'completed'"/>
            </tree>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--  Form view                                                    -->
    <!-- ============================================================ -->
    <record id="fayna_instructor_course_form" model="ir.ui.view">
        <field name="name">fayna.instructor.course.form</field>
        <field name="model">fayna.instructor.course</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_enrollment" type="object"
                            string="Open Enrollment"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_start" type="object"
                            string="Start Course"
                            class="btn-primary"
                            invisible="state != 'open'"/>
                    <button name="action_complete" type="object"
                            string="Complete"
                            class="btn-success"
                            invisible="state != 'in_progress'"/>
                    <button name="action_cancel" type="object"
                            string="Cancel"
                            class="btn-danger"
                            invisible="state in ('completed', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,open,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Course name…"/></h1>
                    </div>
                    <group>
                        <group string="Schedule">
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="location"/>
                        </group>
                        <group string="Capacity &amp; Pricing">
                            <field name="max_participants"/>
                            <field name="enrolled_count"/>
                            <field name="available_spots"/>
                            <field name="currency_id" options="{'no_create': True}"/>
                            <field name="price" widget="monetary"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" widget="html"/>
                        </page>
                        <page string="Enrollments">
                            <field name="enrollment_ids" context="{'default_course_id': active_id}">
                                <tree editable="bottom"
                                      decoration-muted="state == 'cancelled'"
                                      decoration-success="state == 'confirmed'">
                                    <field name="partner_id"/>
                                    <field name="enrollment_date"/>
                                    <field name="payment_status" widget="badge"
                                           decoration-success="payment_status == 'paid'"
                                           decoration-warning="payment_status == 'unpaid'"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'confirmed'"
                                           decoration-info="state == 'pending'"
                                           decoration-muted="state == 'cancelled'"
                                           decoration-primary="state == 'completed'"/>
                                    <button name="action_confirm" type="object"
                                            string="Confirm" icon="fa-check"
                                            invisible="state != 'pending'"/>
                                    <button name="action_cancel" type="object"
                                            string="Cancel" icon="fa-times"
                                            invisible="state in ('cancelled', 'completed')"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--  Search view                                                  -->
    <!-- ============================================================ -->
    <record id="fayna_instructor_course_search" model="ir.ui.view">
        <field name="name">fayna.instructor.course.search</field>
        <field name="model">fayna.instructor.course</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="location"/>
                <filter string="Open" name="open" domain="[('state','=','open')]"/>
                <filter string="In Progress" name="in_progress" domain="[('state','=','in_progress')]"/>
                <filter string="Completed" name="completed" domain="[('state','=','completed')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter string="Has Spots" name="has_spots" domain="[('available_spots','>',0)]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Start Date" name="group_start" context="{'group_by': 'start_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--  Action                                                       -->
    <!-- ============================================================ -->
    <record id="action_fayna_instructor_course" model="ir.actions.act_window">
        <field name="name">Courses</field>
        <field name="res_model">fayna.instructor.course</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="fayna_instructor_course_search"/>
        <field name="context">{'search_default_open': 1}</field>
    </record>
</odoo>
